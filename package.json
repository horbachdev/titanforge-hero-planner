{
  "name": "titanforge-hero-planner",
  "version": "0.1.0",
  "description": "Electron desktop hero, champion, roster, and quest simulator for Shop Titans builds.",
  "author": "Marcel Horbach",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite src/renderer --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && electron-vite build",
    "build:web": "tsc --noEmit && vite build --config vite.web.config.ts",
    "package": "pnpm.cmd run build && electron-builder --dir",
    "dist": "pnpm.cmd run build && electron-builder --win portable zip --x64",
    "preview:web": "vite preview --host 127.0.0.1 --port 4173 --outDir docs",
    "start": "electron-vite preview",
    "test": "vitest run --config vitest.config.mjs",
    "import:data": "tsx scripts/import-data.mjs",
    "dump:ress-formulas": "node scripts/dump-ress-formulas.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.0",
    "jsdom": "^25.0.1",
    "tsx": "4.23.15",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "build": {
    "appId": "com.marcelhorbach.titanforge",
    "productName": "TitanForge Hero Planner",
    "copyright": "Copyright (c) 2026 Marcel Horbach",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE.md",
      "README.md"
    ],
    "asar": true,
    "win": {
      "artifactName": "TitanForge-Hero-Planner-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "TitanForge-Hero-Planner-${version}-portable-${arch}.${ext}"
    }
  }
}
