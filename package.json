{
  "name": "shop-titans-hero-builder",
  "version": "0.1.0",
  "description": "Desktop hero builder and simulator groundwork for Shop Titans.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite src/renderer --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run --config vitest.config.mjs",
    "import:data": "node scripts/import-data.mjs",
    "dump:ress-formulas": "node scripts/dump-ress-formulas.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "electron": "^33.2.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
